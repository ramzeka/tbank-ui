& {
    $ErrorActionPreference = 'Stop'
    Add-Type -AssemblyName System.Net.Http

    $port = 8765
    $authority = "127.0.0.1:$port"
    $origin = "http://$authority"
    $trustedProxy = $env:TBANK_UI_TRUSTED_PROXY
    $mockProxy = $env:TBANK_UI_MOCK_PROXY
    if ($trustedProxy -and $mockProxy) {
        throw 'Set only one of TBANK_UI_TRUSTED_PROXY and TBANK_UI_MOCK_PROXY.'
    }

    $canonicalPath = '(?:/[A-Za-z0-9_-]+)+'
    $approvedOrigins = [ordered]@{}
    $gatewayPaths = @{}
    $nominalPaths = @{}
    function Add-ProxyEnvironment($name, $value, $demo, $source, $nominalPath) {
        $configuredUri = $null
        if ($value -cnotmatch "\Ahttps?://[^/?#\\\s]+(?:$canonicalPath)?/?\z" -or
            -not [Uri]::TryCreate($value, [UriKind]::Absolute, [ref]$configuredUri) -or
            $configuredUri.UserInfo -or $configuredUri.Query -or $configuredUri.Fragment -or
            ($demo -and ($configuredUri.Scheme -cne 'http' -or $configuredUri.Host -cne '127.0.0.1' -or $configuredUri.Port -eq $port)) -or
            (!$demo -and ($configuredUri.Scheme -cne 'https' -or $configuredUri.Host -match '(^|\.)(tbank\.ru|tinkoff\.ru|t-bank-app\.ru)\.?$'))) {
            if ($demo) { throw 'Set an HTTP mock address on 127.0.0.1 with a separate port and no query parameters.' }
            throw "Set a trusted HTTPS origin in $source. Use a canonical gateway path and omit query parameters."
        }
        if (!$nominalPath) { $nominalPath = '/api/v1/nominal-accounts' }
        if ($nominalPath -cnotmatch "\A$canonicalPath\z") { throw "Invalid nominal accounts path in $source." }
        $approvedOrigins[$name] = $configuredUri.GetLeftPart([UriPartial]::Authority)
        $gatewayPaths[$name] = $configuredUri.AbsolutePath.TrimEnd('/')
        $nominalPaths[$name] = $nominalPath
    }

    $proxySource = 'proxy.cfg'
    if ($mockProxy) {
        $proxySource = 'TBANK_UI_MOCK_PROXY'
        Add-ProxyEnvironment 'mock' $mockProxy $true $proxySource
    } elseif ($trustedProxy) {
        $proxySource = 'TBANK_UI_TRUSTED_PROXY'
        Add-ProxyEnvironment 'custom' $trustedProxy $false $proxySource
    } else {
        $appDirectory = Split-Path -Parent $env:TBANK_UI_DIST
        $proxyFile = Join-Path $appDirectory $proxySource
        $legacyFile = Join-Path $appDirectory 'proxy-origin.txt'
        if (Test-Path -LiteralPath $proxyFile -PathType Leaf) {
            $settings = @{}
            $lineNumber = 0
            foreach ($line in [IO.File]::ReadAllLines($proxyFile, [Text.Encoding]::UTF8)) {
                $lineNumber++
                if ($line -match '^\s*(?:[#;]|$)') { continue }
                if ($line -notmatch '^\s*((?:dev|stage|prod)(?:\.prefix)?)\s*=\s*(.*)$') {
                    throw "Invalid proxy.cfg line $lineNumber. Use dev, stage, prod or their .prefix settings."
                }
                $name = $Matches[1].ToLowerInvariant()
                $value = $Matches[2].Trim()
                if ($settings.ContainsKey($name)) { throw "Duplicate environment '$name' in proxy.cfg." }
                $settings[$name] = $value
            }
            foreach ($name in @('dev', 'stage', 'prod')) {
                if ($settings[$name]) {
                    Add-ProxyEnvironment $name $settings[$name] $false "proxy.cfg ($name)" $settings["$name.prefix"]
                } elseif ($settings["$name.prefix"]) {
                    throw "Set an address for '$name' before configuring its .prefix."
                }
            }
        } elseif (Test-Path -LiteralPath $legacyFile -PathType Leaf) {
            $proxySource = 'proxy-origin.txt'
            $value = [IO.File]::ReadAllText($legacyFile, [Text.Encoding]::UTF8).Trim()
            Add-ProxyEnvironment 'custom' $value $false $proxySource
        }
    }
    $runId = [Guid]::NewGuid().ToString('N')
    $idPart = '[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}'
    $beneficiary = "/beneficiaries/$idPart"
    $accounts = "$beneficiary/bank-details"
    $deal = "/deals/$idPart"
    $steps = "$deal/steps"
    $step = "$steps/$idPart"
    $deponent = "$step/deponents/$idPart"
    $recipients = "$step/recipients"
    $recipient = "$recipients/$idPart"
    $nominalRoutes = @{
        GET = "\A(?:/beneficiaries|$beneficiary|$accounts(?:/$idPart)?|/incoming-transactions|/payments(?:/$idPart)?|/virtual-accounts/(?:balances|holds|transfers(?:/$idPart)?)|/deals|$deal(?:/is-valid)?|$steps|$step|$step/deponents|$deponent|$recipients|$recipient)\z"
        POST = "\A(?:/beneficiaries|$accounts(?:/$idPart/set-default)?|/incoming-transactions/$idPart/identify|/payments(?:/$idPart/retry)?|/virtual-accounts/transfers|/deals|$deal/(?:accept|draft|cancel)|$steps|$step/complete|$recipients|$recipient/update-bank-details)\z"
        PUT = "\A(?:$beneficiary|$accounts/$idPart|$step|$deponent|$recipient)\z"
        DELETE = "\A(?:$accounts/$idPart|$deal|$step|$deponent|$recipient)\z"
    }
    $keyedPosts = "\A(?:/beneficiaries|$accounts|/payments|/virtual-accounts/transfers|/deals|$steps|$recipients)\z"
    $crlf = [string][char]13 + [char]10
    $maxHeader = 16384
    $maxBody = 262144
    $empty = [byte[]]@()
    $securityHeaders = @(
        'Connection: close',
        'Cache-Control: no-store',
        "X-TBank-Run: $runId",
        'X-Content-Type-Options: nosniff',
        'Referrer-Policy: no-referrer',
        "Content-Security-Policy: default-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    ) -join $crlf

    $routes = [Collections.Generic.Dictionary[string,object]]::new([StringComparer]::Ordinal)
    function Add-Asset($route, $file, $type) {
        $bytes = [IO.File]::ReadAllBytes((Join-Path $env:TBANK_UI_DIST $file))
        $routes.Add($route, @{ Body = $bytes; Type = $type })
    }

    function Send-Response($stream, $status, $type, [byte[]]$body) {
        if ($type.StartsWith('text/')) { $type += '; charset=utf-8' }
        $headers = @(
            "HTTP/1.1 $status",
            "Content-Type: $type",
            ('Content-Length: ' + $body.Length.ToString([Globalization.CultureInfo]::InvariantCulture)),
            $securityHeaders, '', ''
        ) -join $crlf
        $encoded = [Text.Encoding]::ASCII.GetBytes($headers)
        $stream.Write($encoded, 0, $encoded.Length)
        $stream.Write($body, 0, $body.Length)
    }

    function Send-Json($stream, $status, $payload) {
        $body = [Text.Encoding]::UTF8.GetBytes((ConvertTo-Json -InputObject $payload -Compress))
        Send-Response $stream $status 'application/json' $body
    }

    function Get-Header($lines, $name) {
        $prefix = "$($name):"
        $matching = @($lines | Where-Object { $_.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase) })
        if ($matching.Count -eq 1) { return $matching[0].Substring($prefix.Length).Trim() }
        return $null
    }

    function Read-RequestHeader($connection, $headers, $bodyOffset) {
        $stream = $connection.Stream
        $lines = $headers -split $crlf
        if ((Get-Header $lines 'Host') -cne $authority -or
            $lines[0] -cnotmatch '^([^ ]+) (/[^ ?#]*)(\?[^ #]*)? HTTP/1\.[01]$') {
            Send-Response $stream '400 Bad Request' 'text/plain' $empty
            return $true
        }
        $method = $Matches[1]
        $path = $Matches[2]
        if ($path.StartsWith('/api/relay/', [StringComparison]::Ordinal)) {
            $query = $Matches[3]
            if ($method -cnotin @('GET', 'POST', 'PUT', 'DELETE')) {
                Send-Json $stream '405 Method Not Allowed' @{ message = 'Unsupported API method.' }
                return $true
            }
            $targetPath = $path.Substring('/api/relay'.Length)
            if ($targetPath -cnotmatch "\A$canonicalPath\z") {
                Send-Json $stream '400 Bad Request' @{ message = 'Invalid API path.' }
                return $true
            }
            $requestOrigin = Get-Header $lines 'Origin'
            $fetchSite = Get-Header $lines 'Sec-Fetch-Site'
            if (((($lines -match '^Origin:') -or $method -cne 'GET') -and $requestOrigin -cne $origin) -or
                ($fetchSite -and $fetchSite -cne 'same-origin') -or (Get-Header $lines 'X-TBank-Run') -cne $runId) {
                Send-Json $stream '403 Forbidden' @{ error = 'invalid_origin' }
                return $true
            }
            $length = Get-Header $lines 'Content-Length'
            if ($lines -match '^Transfer-Encoding[ \t]*:' -or
                (($lines -match '^Content-Length:') -and ($length -notmatch '^(0|[1-9][0-9]{0,5})$' -or [int]$length -gt $maxBody)) -or
                ([int]$length -gt 0 -and ($method -cin @('GET', 'DELETE') -or (Get-Header $lines 'Content-Type') -ne 'application/json'))) {
                Send-Json $stream '400 Bad Request' @{ error = 'invalid_request' }
                return $true
            }
            $connection.Headers = $lines
            $connection.Method = $method
            $connection.TargetPath = $targetPath
            $connection.Query = $query
            $connection.BodyOffset = $bodyOffset
            $connection.BodyLength = [int]$length
            return $false
        }

        if ($method -cne 'GET') {
            Send-Response $stream '405 Method Not Allowed' 'text/plain' $empty
        } elseif ($routes.ContainsKey($path)) {
            $asset = $routes[$path]
            Send-Response $stream '200 OK' $asset.Type $asset.Body
        } else {
            Send-Response $stream '404 Not Found' 'text/plain' $empty
        }
        return $true
    }

    function Start-Upstream($connection) {
        $stream = $connection.Stream
        $proxyOrigin = Get-Header $connection.Headers 'X-TBank-Proxy-Origin'
        $environment = Get-Header $connection.Headers 'X-TBank-Environment'
        $base = $null
        $target = $null
        $authorization = Get-Header $connection.Headers 'Authorization'
        $account = Get-Header $connection.Headers 'bankAccountId'
        $key = Get-Header $connection.Headers 'Idempotency-Key'
        $uuidPattern = '^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$'
        if (!$proxyOrigin -or -not [Uri]::TryCreate($proxyOrigin, [UriKind]::Absolute, [ref]$base) -or
            $base.UserInfo -or $base.GetLeftPart([UriPartial]::Authority) -cne $proxyOrigin -or
            -not [Uri]::TryCreate(($proxyOrigin + $connection.TargetPath + $connection.Query), [UriKind]::Absolute, [ref]$target) -or
            $target.GetLeftPart([UriPartial]::Authority) -cne $proxyOrigin -or
            $target.AbsolutePath -cne $connection.TargetPath -or
            ($target.Scheme -ne 'https' -and ($target.Scheme -ne 'http' -or $target.Host -cne '127.0.0.1')) -or
            $target.UserInfo -or $target.Fragment -or $target.GetLeftPart([UriPartial]::Authority) -ceq $origin -or
            $target.Host -match '(^|\.)(tbank\.ru|tinkoff\.ru|t-bank-app\.ru)\.?$' -or
            $authorization -cnotmatch '^Bearer [A-Za-z0-9._~+/-]+=*$' -or
            ($account -and $account -notmatch $uuidPattern) -or ($key -and $key -notmatch $uuidPattern)) {
            Send-Json $stream '400 Bad Request' @{ message = 'Invalid API URL, method or headers.' }
            return $true
        }
        if (!$environment -or !$approvedOrigins.Contains($environment) -or $proxyOrigin -cne $approvedOrigins[$environment]) {
            Send-Json $stream '403 Forbidden' @{ message = 'Proxy origin is not approved for the selected environment.' }
            return $true
        }
        $gateway = $gatewayPaths[$environment]
        $nominal = $nominalPaths[$environment]
        $nominalBase = $gateway + $nominal
        $route = if ($target.AbsolutePath.StartsWith($nominalBase + '/', [StringComparison]::Ordinal)) {
            $target.AbsolutePath.Substring($nominalBase.Length)
        } else { '' }
        $scoringBase = $gateway + ($nominal -creplace '/v1/nominal-accounts\z', '/v2/nominal-accounts')
        $specialRead = $connection.Method -ceq 'GET' -and
            ($target.AbsolutePath -ceq "$gateway/api/v1/statement" -or
             $target.AbsolutePath -ceq "$scoringBase/beneficiaries/scoring")
        if (!$specialRead -and $route -cnotmatch $nominalRoutes[$connection.Method]) {
            Send-Json $stream '405 Method Not Allowed' @{ message = 'Unsupported API operation.' }
            return $true
        }
        if ($connection.Method -ceq 'POST' -and $route -cmatch $keyedPosts -and !$key) {
            Send-Json $stream '400 Bad Request' @{ message = 'Idempotency-Key is required for this operation.' }
            return $true
        }
        if (@($connections | Where-Object { $_.Exchange }).Count -ge 8) {
            Send-Json $stream '503 Service Unavailable' @{ message = 'Local server is busy.' }
            return $true
        }

        $request = [Net.Http.HttpRequestMessage]::new([Net.Http.HttpMethod]::new($connection.Method), $target)
        $request.Headers.Authorization = [Net.Http.Headers.AuthenticationHeaderValue]::Parse($authorization)
        if ($account) { [void]$request.Headers.TryAddWithoutValidation('bankAccountId', $account) }
        if ($key) { [void]$request.Headers.TryAddWithoutValidation('Idempotency-Key', $key) }
        if ($connection.BodyLength -gt 0) {
            $request.Content = [Net.Http.ByteArrayContent]::new($connection.Data, $connection.BodyOffset, $connection.BodyLength)
            $request.Content.Headers.ContentType = [Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
        }
        $connection.UpstreamRequest = $request
        $connection.Cancellation = [Threading.CancellationTokenSource]::new()
        $connection.Exchange = $http.SendAsync($request, $connection.Cancellation.Token)
        $connection.Data = $null
        $connection.Headers = $null
        return $false
    }

    function Complete-Upstream($connection) {
        if ($connection.Client.Client.Poll(0, [Net.Sockets.SelectMode]::SelectRead) -and $connection.Client.Available -eq 0) {
            return $true
        }
        if (-not $connection.Exchange.IsCompleted) { return $false }
        $stream = $connection.Stream
        if ($connection.Exchange.IsFaulted -or $connection.Exchange.IsCanceled) {
            Send-Json $stream '502 Bad Gateway' @{ message = 'Local server could not reach the API proxy.' }
            return $true
        }

        $response = $connection.Exchange.Result
        try {
            $status = [int]$response.StatusCode
            $reason = $response.StatusCode.ToString()
            $body = $empty
            $type = 'text/plain'
            if ($response.Content -and $status -notin @(204, 205, 304)) {
                $body = $response.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult()
                $media = $response.Content.Headers.ContentType
                if ($media -and $media.MediaType -match '^application/(?:[A-Za-z0-9._+-]+\+)?json$') {
                    $type = 'application/json'
                }
            }
            Send-Response $stream "$status $reason" $type $body
        } finally {
            $response.Dispose()
        }
        return $true
    }

    function Read-Connection($connection) {
        if ($connection.Exchange) { return Complete-Upstream $connection }
        if ($connection.Timer.ElapsedMilliseconds -ge 2000) { return $true }
        if (-not $connection.Client.Client.Poll(0, [Net.Sockets.SelectMode]::SelectRead)) { return $false }

        $data = $connection.Data
        $used = $connection.Used
        $count = $connection.Stream.Read($data, $used, $data.Length - $used)
        if ($count -eq 0) { return $true }
        $end = $used + $count
        $connection.Used = $end

        if (!$connection.BodyOffset) {
            for ($index = [Math]::Max(0, $used - 3); $index -lt [Math]::Min($end - 3, $maxHeader - 3); $index++) {
                if ($data[$index] -eq 13 -and $data[$index + 1] -eq 10 -and
                    $data[$index + 2] -eq 13 -and $data[$index + 3] -eq 10) {
                    $headers = [Text.Encoding]::ASCII.GetString($data, 0, $index)
                    if (Read-RequestHeader $connection $headers ($index + 4)) { return $true }
                    break
                }
            }
            if (!$connection.BodyOffset) { return $end -ge $maxHeader }
        }

        if ($end -ge ($connection.BodyOffset + $connection.BodyLength)) {
            return Start-Upstream $connection
        }
        return $false
    }

    function Close-Connection($connection) {
        if ($connection.Cancellation) {
            $connection.Cancellation.Cancel()
            $connection.Cancellation.Dispose()
            $connection.UpstreamRequest.Dispose()
        }
        $connection.Client.Dispose()
    }

    $routes.Add('/health', @{ Body = [Text.Encoding]::ASCII.GetBytes($runId); Type = 'text/plain' })
    $index = [IO.File]::ReadAllText((Join-Path $env:TBANK_UI_DIST 'index.html'), [Text.Encoding]::UTF8)
    $proxyConfiguration = ConvertTo-Json -InputObject @{
        source = $proxySource; origins = $approvedOrigins; paths = $gatewayPaths; prefixes = $nominalPaths
    } -Compress
    $index = $index.Replace('__TBANK_PROXY_ENVIRONMENTS__', [Security.SecurityElement]::Escape($proxyConfiguration))
    $routes.Add('/', @{
        Body = [Text.Encoding]::UTF8.GetBytes($index.Replace('__TBANK_RUN_ID__', $runId))
        Type = 'text/html'
    })
    Add-Asset '/identify.js' 'identify.js' 'text/javascript'
    Add-Asset '/amount.js' 'amount.js' 'text/javascript'
    Add-Asset '/billing.js' 'billing.js' 'text/javascript'
    Add-Asset '/dashboard.js' 'dashboard.js' 'text/javascript'
    Add-Asset '/dashboard-data.js' 'dashboard-data.js' 'text/javascript'
    Add-Asset '/copy-id.js' 'copy-id.js' 'text/javascript'
    Add-Asset '/pagination.js' 'pagination.js' 'text/javascript'
    Add-Asset '/transfers.js' 'transfers.js' 'text/javascript'
    Add-Asset '/statement.js' 'statement.js' 'text/javascript'
    Add-Asset '/statement-calendar.js' 'statement-calendar.js' 'text/javascript'
    Add-Asset '/record-details.js' 'record-details.js' 'text/javascript'
    Add-Asset '/deals.js' 'deals.js' 'text/javascript'
    Add-Asset '/step-parties.js' 'step-parties.js' 'text/javascript'
    Add-Asset '/app.js' 'app.js' 'text/javascript'
    Add-Asset '/entity-editor.js' 'entity-editor.js' 'text/javascript'
    Add-Asset '/beneficiaries.js' 'beneficiaries.js' 'text/javascript'
    Add-Asset '/beneficiary-schema.js' 'beneficiary-schema.js' 'text/javascript'
    Add-Asset '/inter.woff2' 'inter.woff2' 'font/woff2'
    Add-Asset '/tbank-mark.png' 'tbank-mark.png' 'image/png'
    Add-Asset '/smlt-mark.svg' 'smlt-mark.svg' 'image/svg+xml'
    Add-Asset '/styles.css' 'styles.css' 'text/css'

    $handler = [Net.Http.HttpClientHandler]::new()
    $handler.AllowAutoRedirect = $false
    $handler.UseCookies = $false
    $handler.AutomaticDecompression = [Net.DecompressionMethods]::GZip -bor [Net.DecompressionMethods]::Deflate
    $http = [Net.Http.HttpClient]::new($handler)
    $http.Timeout = [TimeSpan]::FromSeconds(20)
    $http.MaxResponseContentBufferSize = 8388608

    $listener = [Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback, $port)
    $connections = [Collections.Generic.List[hashtable]]::new()
    try {
        $listener.ExclusiveAddressUse = $true
        $listener.Start()
        Write-Host "Open in browser: $origin/"
        Write-Host 'Close this console to stop the local server.'
        try { Start-Process -FilePath "$origin/" } catch { Write-Warning "Open manually: $origin/" }

        while ($true) {
            while ($connections.Count -lt 16 -and $listener.Pending()) {
                $client = $listener.AcceptTcpClient()
                $stream = $client.GetStream()
                $stream.ReadTimeout = 1000
                $stream.WriteTimeout = 1000
                $connections.Add(@{
                    Client = $client; Stream = $stream; Data = [byte[]]::new($maxHeader + $maxBody)
                    Used = 0; Timer = [Diagnostics.Stopwatch]::StartNew()
                })
            }
            for ($index = $connections.Count - 1; $index -ge 0; $index--) {
                $connection = $connections[$index]
                try {
                    if (-not (Read-Connection $connection)) { continue }
                } catch [IO.IOException], [Net.Sockets.SocketException] {
                }
                Close-Connection $connection
                $connections.RemoveAt($index)
            }
            Start-Sleep -Milliseconds 20
        }
    } catch [Net.Sockets.SocketException] {
        if ($_.Exception.SocketErrorCode -eq [Net.Sockets.SocketError]::AddressAlreadyInUse) {
            throw "Port $port is in use. Close the previous launch window and try again."
        }
        throw
    } finally {
        foreach ($connection in $connections) { Close-Connection $connection }
        $listener.Stop()
        $http.Dispose()
    }
}

